          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Authority or receiver origin refused"
          },
          "404": {
            "description": "Record unavailable to this receiver"
          },
          "409": {
            "description": "Concurrent record or grant change"
          },
          "429": {
            "description": "Rate limit; Retry-After is 60 seconds"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              }
            }
          }
        }
      }
    },
    "/connections/{connection_id}/events": {
      "get": {
        "operationId": "pageEvents",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Owner session and current receiver grant required. Matching Origin required for mutation. 60 requests per person per UTC minute, shared with version 1 reads and drafts.",
        "parameters": [
          {
            "name": "connection_id",
            "in": "path",
