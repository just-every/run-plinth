    "/connections/{connection_id}/deliver/{event_id}": {
      "post": {
        "operationId": "deliverEvent",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Owner session and current receiver grant required. Matching Origin required for mutation. 60 requests per person per UTC minute, shared with version 1 reads and drafts.",
        "parameters": [
          {
            "name": "connection_id",
