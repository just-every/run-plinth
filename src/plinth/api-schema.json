  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "operator_session"
      }
    },
    "schemas": {
      "Job": {
        "type": "object",
        "required": [
          "id",
          "version",
          "name",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "quoting",
              "active"
            ]
          }
        }
      },
      "Draft": {
        "type": "object",
        "required": [
          "id",
          "description",
          "amount_cents",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "amount_cents": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Subscription": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "operator_id": {
            "type": "string"
          },
          "credential_id": {
            "type": "string"
          },
          "receiver": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "operator_version": {
            "type": "integer"
          },
          "job_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "event_types": {
            "type": "array",
            "items": {
              "enum": [
                "job.updated",
                "financial.updated",
                "decision.approved",
                "change.approved"
              ]
            }
          },
          "generation": {
            "type": "integer"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "operator_id",
          "credential_id",
          "receiver",
          "created_at",
          "operator_version",
          "job_ids",
          "event_types",
          "generation",
          "revoked_at"
        ]
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "job_version": {
            "type": "integer"
          },
          "subject_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "job_id",
          "type",
          "created_at",
          "job_version",
          "subject_id"
        ]
      },
      "ListedEvent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "job_version": {
            "type": "integer"
          },
          "subject_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "sequence": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "job_id",
          "type",
          "created_at",
          "job_version",
          "subject_id",
          "sequence"
        ]
      },
      "Webhook": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "job_version": {
            "type": "integer"
          },
          "subject_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "api_version": {
            "const": "1"
          }
        },
        "required": [
          "id",
          "job_id",
          "type",
          "created_at",
          "job_version",
          "subject_id",
          "api_version"
        ]
      },
      "Delivery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "subscription_id": {
            "type": "string"
          },
          "event_id": {
            "type": "string"
          },
          "started_at": {
            "type": "string"
          },
          "generation": {
            "type": "integer"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
