{
  "openapi": "3.1.0",
  "info": {
    "title": "Plinth native draft API",
    "version": "1.0.0",
    "description": "Current native version 1 surface. Bearer credentials are draft-only; human final actions use existing session-gated business doors. Other records, reports and import and export doors are documented in docs/COMMANDS.md; their complete machine schemas remain pending."
  },
  "servers": [
    {
      "url": "/api/plinth/v1"
    }
  ],
  "security": [
    {
      "bearer": []
    },
    {
      "session": []
    }
  ],
  "paths": {
    "/jobs": {
      "get": {
        "operationId": "pageJobs",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "jobs",
                    "next"
                  ],
                  "properties": {
                    "jobs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Job"
                      }
                    },
                    "next": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Current authority refused"
          },
          "404": {
            "description": "Unavailable record"
          },
          "409": {
            "description": "Stale version or conflicting replay"
          },
          "429": {
            "description": "60 requests per person per UTC minute"
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "operationId": "readJob",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "job"
                  ],
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Current authority refused"
          },
          "404": {
            "description": "Unavailable record"
          },
          "409": {
            "description": "Stale version or conflicting replay"
          },
          "429": {
            "description": "60 requests per person per UTC minute"
          }
        }
      }
    },
    "/jobs/{job_id}/changes": {
      "post": {
        "operationId": "prepareChange",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "job",
                    "draft",
                    "replayed"
                  ],
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    },
                    "draft": {
                      "$ref": "#/components/schemas/Draft"
                    },
                    "replayed": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Current authority refused"
          },
          "404": {
            "description": "Unavailable record"
          },
          "409": {
            "description": "Stale version or conflicting replay"
          },
          "429": {
            "description": "60 requests per person per UTC minute"
          },
          "201": {
            "description": "Current authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "job",
                    "draft",
                    "replayed"
                  ],
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    },
                    "draft": {
                      "$ref": "#/components/schemas/Draft"
                    },
                    "replayed": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expected_version",
                  "description",
                  "amount_cents"
                ],
                "properties": {
                  "expected_version": {
                    "type": "integer"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "amount_cents": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/changes/{change_id}/approve": {
      "post": {
        "operationId": "approveChange",
        "description": "Assigned client session only. Every bearer credential is refused before any final action. Uses the native approval door.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "change_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expected_version"
                ],
                "additionalProperties": false,
                "properties": {
                  "expected_version": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Native immutable human approval result"
          },
          "403": {
            "description": "Bearer or non-client authority refused"
          },
          "409": {
            "description": "Stale or already approved"
          }
        }
      }
    },
    "/connections": {
      "get": {
        "operationId": "listConnections",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Owner session and current receiver grant required. Matching Origin required for mutation. 60 requests per person per UTC minute, shared with version 1 reads and drafts.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "subscriptions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Subscription"
                      }
                    }
                  },
                  "required": [
                    "subscriptions"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Authority or receiver origin refused"
          },
          "404": {
            "description": "Record unavailable to this receiver"
          },
          "409": {
            "description": "Concurrent record or grant change"
          },
          "429": {
            "description": "Rate limit; Retry-After is 60 seconds"
          }
        }
      },
      "post": {
        "operationId": "createConnection",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Owner session and current receiver grant required. Matching Origin required for mutation. 60 requests per person per UTC minute, shared with version 1 reads and drafts.",
        "parameters": [],
        "responses": {
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Authority or receiver origin refused"
          },
          "404": {
            "description": "Record unavailable to this receiver"
          },
          "409": {
            "description": "Concurrent record or grant change"
          },
          "429": {
            "description": "Rate limit; Retry-After is 60 seconds"
          },
          "201": {
            "description": "Current result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "subscription": {
                      "$ref": "#/components/schemas/Subscription"
                    },
                    "signing_key": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "subscription",
                    "signing_key"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Consent"
              }
            }
          }
        }
      }
    },
    "/connections/{connection_id}/rotate": {
      "post": {
