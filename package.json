{
  "name": "@construction/plinth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --build --incremental",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "test:email-link": "node tests/email-link.mjs",
    "onboard": "node scripts/install.mjs",
    "build:app": "vite build",
    "verify:app": "pnpm run build && pnpm run typecheck && pnpm run test:plinth && pnpm run test:email-link && pnpm run test:site",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:plinth": "node --test --test-concurrency=1 tests/plinth/*.test.mjs",
    "test:site": "node --test tests/site.test.mjs",
    "delivery:spec": "node scripts/build-deployment-spec.mjs",
    "check:deployment-spec": "node scripts/build-deployment-spec.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tesseract.js-data/eng": "1.0.0",
    "@xmldom/xmldom": "0.9.12",
    "hono": "4.13.7",
    "jszip": "3.10.2",
    "marked": "18.1.1",
    "office-oxide-wasm": "0.1.8",
    "pako": "3.0.3",
    "parse5": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "utif2": "4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.85",
    "@types/node": "22.18.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.1",
    "ical.js": "2.2.1",
    "miniflare": "5.20260907.0-alpha",
    "pdfjs-dist": "6.4.299",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.29.1",
      "source-map-js": "1.2.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "license": "MIT",
  "repository": "https://github.com/just-every/run-plinth"
}
