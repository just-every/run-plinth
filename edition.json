{
  "schemaVersion": 1,
  "id": "just-every/run-plinth",
  "toolchain": {
    "id": "runeditrun/edition-authoring",
    "version": "1.1.0"
  },
  "components": [
    {
      "id": "just-every/plinth",
      "role": "edition",
      "source": {
        "kind": "local",
        "paths": [
          "src",
          "public",
          "scripts/installer",
          "scripts/build-deployment-spec.mjs",
          "packaging.json",
          "rer-setup.json"
        ],
        "origin": {
          "repository": "https://github.com/runeditrun/base",
          "revision": "11f94fec479228d71ba6d7dd6ea7796c0d42c544",
          "path": "foundation/runtime",
          "paths": [
            "run-site.ts",
            "identity.ts"
          ]
        },
        "mappings": [
          {
            "path": "src/base/run-site.ts",
            "originPath": "run-site.ts"
          },
          {
            "path": "src/base/identity.ts",
            "originPath": "identity.ts"
          }
        ]
      }
    },
    {
      "id": "runeditrun/delivery-producer-adaptation",
      "role": "module",
      "source": {
        "kind": "local",
        "paths": [
          "scripts/delivery/base/capabilities.mjs",
          "scripts/delivery/base/generators/validation.mjs",
          "scripts/delivery/base/payloads.mjs",
          "scripts/delivery/base/sql-statements.mjs",
          "scripts/delivery/base/setup-manifest.mjs"
        ],
        "origin": {
          "repository": "https://github.com/runeditrun/base",
          "revision": "11f94fec479228d71ba6d7dd6ea7796c0d42c544",
          "path": "modules/delivery-producer",
          "paths": [
            "capabilities.mjs",
            "generators/validation.mjs",
            "payloads.mjs",
            "sql-statements.mjs",
            "setup-manifest.mjs"
          ]
        },
        "mappings": [
          {
            "path": "scripts/delivery/base/capabilities.mjs",
            "originPath": "capabilities.mjs"
          },
          {
            "path": "scripts/delivery/base/generators/validation.mjs",
            "originPath": "generators/validation.mjs"
          },
          {
            "path": "scripts/delivery/base/payloads.mjs",
            "originPath": "payloads.mjs"
          },
          {
            "path": "scripts/delivery/base/sql-statements.mjs",
            "originPath": "sql-statements.mjs"
          },
          {
            "path": "scripts/delivery/base/setup-manifest.mjs",
            "originPath": "setup-manifest.mjs"
          }
        ]
      }
    }
  ]
}
