{
  "version": 1,
  "project": "construction/plinth",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "resend"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "INSTALLATION_KEY",
      "environment": "INSTALLATION_KEY"
    },
    {
      "binding": "INSTALLATION_KEY_PREVIOUS",
      "environment": "INSTALLATION_KEY_PREVIOUS",
      "optional": true
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM"
    },
    {
      "binding": "MAIL_EVENT_KEY",
      "environment": "MAIL_EVENT_KEY",
      "optional": true
    },
    {
      "binding": "STRIPE_SECRET_KEY",
      "environment": "STRIPE_SECRET_KEY",
      "optional": true
    },
    {
      "binding": "STRIPE_WEBHOOK_SECRET",
      "environment": "STRIPE_WEBHOOK_SECRET",
      "optional": true
    }
  ],
  "platforms": [
    "workers",
    "container"
  ],
  "publicSettings": [
    "MAIL_PROVIDER",
    "MAIL_FROM",
    "MAIL_RELAY_URL",
    "MAIL_ACCOUNT_ID",
    "MAIL_REPLY_DOMAIN"
  ]
}
